{
  "name": "seatflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "node scripts/build.mjs",
    "postbuild": "node scripts/push-after-build.mjs",
    "start": "node app.js",
    "start:api": "pnpm --filter @seatflow/api start",
    "start:web": "pnpm --filter @seatflow/web start",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@seatflow/geometry": "file:packages/geometry",
    "@seatflow/planner-core": "file:packages/planner-core",
    "@seatflow/rules": "file:packages/rules",
    "@seatflow/types": "file:packages/types",
    "@seatflow/ui": "file:packages/ui",
    "fastify": "^5.3.3",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
